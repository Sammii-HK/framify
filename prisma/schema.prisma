generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  stripeCustomerId             String?
  plan                         String   @default("free") // free, launch, pro
  stripeSubscriptionId         String?
  subscriptionStatus           String?  // active, past_due, canceled, unpaid
  subscriptionCurrentPeriodEnd DateTime?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  sites                        Site[]
  orders                       Order[]
}

model Site {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  subdomain        String    @unique
  customDomain     String?
  content          Json
  palette          String    @default("dark-celestial")
  cfDeploymentUrl  String?
  tier             String     @default("free") // free, launch, pro
  status           SiteStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  orders           Order[]
  submissions      FormSubmission[]
  images           SiteImage[]
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  siteId           String
  site             Site        @relation(fields: [siteId], references: [id])
  amount           Int         // in pence
  currency         String      @default("gbp")
  stripePaymentId  String?
  stripeInvoiceId  String?
  type             String      @default("one_time") // one_time, subscription, domain
  status           OrderStatus @default(PENDING)
  createdAt        DateTime    @default(now())
}

enum SiteStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
}

model PromptTemplate {
  id          String   @id @default(cuid())
  name        String
  prompt      String
  description String?
  category    String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Template {
  id             String     @id @default(cuid())
  userId         String
  title          String
  prompt         String
  style          String
  code           String
  framerUrl      String?
  createdAt      DateTime   @default(now())
  isPublic       Boolean    @default(false)
  price          Float?
  description    String?
  tags           String[]   @default([])
  category       String?
  licenseType    String?    @default("personal")
  thumbnailUrl   String?
  viewCount      Int        @default(0)
  downloadCount  Int        @default(0)
  salesCount     Int        @default(0)
  featured       Boolean    @default(false)
  baseTemplateId String?
  Template       Template?  @relation("TemplateToTemplate", fields: [baseTemplateId], references: [id])
  other_Template Template[] @relation("TemplateToTemplate")
  components     Component[]
}

model Component {
  id              String    @id @default(cuid())
  templateId      String?
  userId          String
  name            String
  code            String
  description     String?
  componentType  String
  price           Float?
  isPublic        Boolean   @default(false)
  tags            String[]  @default([])
  category        String?
  licenseType     String?   @default("personal")
  thumbnailUrl    String?
  framerUrl       String?
  previewUrl      String?
  viewCount       Int       @default(0)
  downloadCount   Int       @default(0)
  salesCount      Int       @default(0)
  featured        Boolean   @default(false)
  marketplaceReady Boolean  @default(false)
  marketplaceUrl  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  template        Template? @relation(fields: [templateId], references: [id])
}

model SiteImage {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id])
  filename    String
  url         String
  size        Int
  contentType String
  createdAt   DateTime @default(now())

  @@index([siteId])
}

model FormSubmission {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}
