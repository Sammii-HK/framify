# Database
DATABASE_URL=postgresql://...

# OpenAI (Fallback)
OPENAI_API_KEY=sk-...

# DeepInfra (Recommended — 80x cheaper than OpenAI for template generation)
# Get a key at https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=di-...

# Framer Integration (Optional)
# Option 1: Direct Access Token
FRAMER_ACCESS_TOKEN=your_token_here
FRAMER_PROJECT_ID=your_project_id_here

# Option 2: OAuth Credentials (Recommended)
# FRAMER_CLIENT_ID=your_client_id
# FRAMER_CLIENT_SECRET=your_client_secret
# FRAMER_PROJECT_ID=your_project_id_here

# Optional Framer Settings
AUTO_PUBLISH_TO_FRAMER=false
FRAMER_API_BASE_URL=https://api.framer.com/v1

# Stripe (Required for payments)
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App URL (for public API endpoints)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Unsplash API (auto-fetches stock images for generated sites)
# Get a key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-key
